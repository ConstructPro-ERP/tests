# Frontend and API gateway deployments. API_BASE_URL may include /api; the
# test helper adds it when omitted.
FRONTEND_BASE_URL=https://your-frontend.vercel.app
API_BASE_URL=https://your-api.vercel.app

# Authorized account: ADMIN, MANAGEMENT, FINANCE, or ACCOUNTANT.
E2E_USER_EMAIL=finance@example.com
E2E_USER_PASSWORD=replace-me

# Stable, disposable demo records. The invoice must be ISSUED, OVERDUE, or
# PARTIALLY_PAID and have at least E2E_PAYMENT_AMOUNT outstanding.
E2E_INVOICE_ID=00000000-0000-4000-8000-000000000000
E2E_PROJECT_ID=00000000-0000-4000-8000-000000000000
E2E_PAYMENT_AMOUNT=1

# Optional restricted account used to verify 403 role rules.
E2E_RESTRICTED_USER_EMAIL=sales@example.com
E2E_RESTRICTED_USER_PASSWORD=replace-me
